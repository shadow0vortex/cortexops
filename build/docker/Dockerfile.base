# =============================================================================
# CortexOps Base Build Image
# =============================================================================
# This Dockerfile is used for building individual services.
# It uses a multi-stage build to ensure minimal final images.
# =============================================================================

# Stage 1: Build
FROM golang:1.22.4-alpine3.20 AS builder

# Install necessary build tools
RUN apk add --no-cache git ca-certificates

WORKDIR /workspace

# Copy dependency files and download
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build binary
# Note: Protos should be generated before running docker build or in a separate step.
# For CI/CD, we recommend generating them once and then building images.
ARG SERVICE_NAME
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /go/bin/${SERVICE_NAME} ./cmd/${SERVICE_NAME}

# Stage 2: Runtime
FROM scratch
ARG SERVICE_NAME

# Import CA certificates for TLS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy the binary from the builder stage
COPY --from=builder /go/bin/${SERVICE_NAME} /app/service

# Set the entrypoint
ENTRYPOINT ["/app/service"]
