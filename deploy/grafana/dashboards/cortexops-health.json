{
  "title": "CortexOps SRE Dashboard",
  "description": "Continuous Runtime Diagnostics and Platform Health",
  "panels": [
    {
      "title": "Platform Health Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "cortexops_platform_health_score",
          "legendFormat": "Health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Goroutines",
      "type": "timeseries",
      "targets": [
        {
          "expr": "cortexops_runtime_goroutines_active",
          "legendFormat": "Goroutines"
        }
      ]
    },
    {
      "title": "Heap Allocation (Bytes)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "cortexops_runtime_heap_alloc_bytes",
          "legendFormat": "Heap Size"
        }
      ]
    },
    {
      "title": "Remediation Rollbacks",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(cortexops_remediation_rollback_total[5m])",
          "legendFormat": "Rollbacks / 5m"
        }
      ]
    }
  ]
}
